{
  "name": "pdfmasterpro",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "overrides": {
    "postcss": "8.5.29"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:tools": "tsx scripts/smoke-tools.ts",
    "test:routes": "node scripts/smoke-routes.mjs",
    "test:ui": "node scripts/smoke-ui.mjs",
    "convert:sdk": "tsx scripts/convert-sdk.ts",
    "test:conversion": "tsx scripts/regression-pdf-to-word.ts",
    "test:billing": "tsx --test tests/integration/billing.test.ts",
    "billing:sandbox": "tsx scripts/billing-sandbox.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:build": "tsx scripts/migrate-on-build.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@tailwindcss/postcss": "^4.1.13",
    "clsx": "^2.1.1",
    "docx": "^9.9.0",
    "google-auth-library": "^11.2.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.89.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.18",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
