# Runtime
PORT=3000
NEXT_PUBLIC_SITE_URL=https://www.pdfmasterpro.com.br

# Optional server-side processing binaries
PDF_RENDERER=pdftoppm
PDF_COMPRESSOR=gs
PDF_TEXT_EXTRACTOR=pdftotext
PDF_HTML_CONVERTER=pdftohtml
OCR_ENGINE=tesseract
PDF_PROTECTOR=qpdf
# Motores Word: msword usa o Microsoft Word instalado (recomendado); valores alternativos
# mantêm a reserva (PDF_TO_WORD_CONVERTER=rebuild recria o layout; SOFFICE_CONVERTER usa o LibreOffice).
PDF_TO_WORD_CONVERTER=msword
WORD_CONVERTER=msword
SOFFICE_CONVERTER=soffice
PDF_HTML_CONVERTER=pdftohtml
OCR_ENGINE=tesseract
PDF_PROTECTOR=qpdf
# Motores Word: msword usa o Microsoft Word instalado (recomendado); valores alternativos
# mantêm a reserva (PDF_TO_WORD_CONVERTER=rebuild recria o layout; SOFFICE_CONVERTER usa o LibreOffice).
PDF_TO_WORD_CONVERTER=msword
WORD_CONVERTER=msword
SOFFICE_CONVERTER=soffice
# Opcional: pasta com os traineddata do Tesseract (útil quando o install é por usuário)
TESSDATA_PREFIX=
# URL do worker de processamento com binários nativos (Docker). Deixe vazio para rodar tudo na mesma função (limitações da plataforma).
PROCESSING_WORKER_URL=

# Postgres (Neon) injetado pela integração da plataforma. Sem ele a aplicação
# opera em modo degradado: processa normalmente, mas não persiste nada.
DATABASE_URL=

# Manus OAuth is injected by WebDev in Cloud/Preview
MANUS_PROJECT_ID=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=
MANUS_JWT_SECRET=

# Google Identity Services OAuth Client ID (public value).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Used for app sessions when Manus OAuth is not configured.
AUTH_SESSION_SECRET=

# Google AdSense: public publisher client ID, format ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Assinaturas Premium (mensal/anual) via Mercado Pago.
# Crie as credenciais de produção em https://www.mercadopago.com.br/developers/panel
MERCADOPAGO_ACCESS_TOKEN=
# Chave pública usada apenas no navegador (opcional nesta integração por redirecionamento).
MERCADOPAGO_PUBLIC_KEY=
# Chave secreta configurada no painel de webhooks do Mercado Pago (valida o x-signature).
MERCADOPAGO_WEBHOOK_SECRET=
# Segredo compartilhado entre o front-end (Vercel) e o worker (Render) para assinar
# o plano do usuário. Deixe vazio para reutilizar AUTH_SESSION_SECRET ou MANUS_JWT_SECRET.
# Precisa ser idêntico nos dois ambientes, senão o worker aplica o plano grátis.
BILLING_SIGNING_SECRET=

# Detector de divergências: configurar no worker, nunca como NEXT_PUBLIC.
# Deixe sem URL/modelo para usar somente regras; nenhuma API paga é ativada automaticamente.
DIVERGENCE_AI_PROVIDER=opencode
DIVERGENCE_OPENCODE_URL=
DIVERGENCE_OPENCODE_PROVIDER=
DIVERGENCE_OPENCODE_MODEL=
# Cabeçalho Authorization completo do servidor/gateway (opcional; segredo).
DIVERGENCE_OPENCODE_AUTHORIZATION=
# Alternativa: DIVERGENCE_AI_PROVIDER=ollama
DIVERGENCE_OLLAMA_URL=
DIVERGENCE_OLLAMA_MODEL=
DIVERGENCE_AI_KEY=
# Alternativa Python em serviço separado: DIVERGENCE_AI_PROVIDER=transformers
DIVERGENCE_TRANSFORMERS_URL=
DIVERGENCE_TRANSFORMERS_MODEL=
DIVERGENCE_TRANSFORMERS_KEY=
DIVERGENCE_RETENTION_MINUTES=60
# Público, lido no build: 4 MB para deixar margem no ingresso serverless.
# Somente eleve até 25 em hospedagem que aceite o corpo multipart maior.
NEXT_PUBLIC_DIVERGENCE_UPLOAD_MB=4

# Publicar somente uma caixa de suporte existente e verificada.
SUPPORT_EMAIL=
# Proteção contra abuso: usa a chave de sessão se não houver uma chave dedicada.
ANTI_ABUSE_SECRET=
# Docker/Render worker usa 1; frontend com banco mantém vazio.
PROCESSING_WORKER_ONLY=
# ResumoMaster: configurar no processador Render; nenhuma chave chega ao navegador.
SUMMARY_AI_PROVIDER=groq
SUMMARY_GROQ_API_KEY=
# true somente após confirmar manualmente que a conta Groq está no plano Free.
SUMMARY_GROQ_FREE_CONFIRMED=false
SUMMARY_CF_ACCOUNT_ID=
SUMMARY_CF_API_TOKEN=
SUMMARY_CF_FREE_CONFIRMED=false
SUMMARY_OLLAMA_CLOUD_KEY=
SUMMARY_OLLAMA_CLOUD_FREE_CONFIRMED=false
# Selecionar IDs disponíveis no plano Free da conta, sem fallback pago.
SUMMARY_STANDARD_MODEL=
SUMMARY_ADVANCED_MODEL=
SUMMARY_PROVIDER_LABEL=
SUMMARY_COST_NOTICE=
# Alternativa em servidor próprio, sem contratação automática:
SUMMARY_OLLAMA_URL=
SUMMARY_AI_KEY=
SUMMARY_OCR_LANGUAGE=por+eng
SUMMARY_TESSERACT=tesseract
# Envio do resumo do chat. Remetente deve ser verificado no Resend.
RESEND_API_KEY=
SUPPORT_FROM_EMAIL=

# Reserva automática, ativar somente após configurar credenciais e cotas gratuitas.
SUMMARY_FALLBACK_ENABLED=false
SUMMARY_FALLBACK_PROVIDER=
SUMMARY_FALLBACK_STANDARD_MODEL=
SUMMARY_FALLBACK_ADVANCED_MODEL=

# Optional legal excerpt AI, reuses only Cloudflare/Groq SUMMARY_* Free-confirmed settings.
# No paid plan is purchased; requires authenticated users, explicit consent and quotas.
LEGAL_AI_ENABLED=false

# Optional native PDF engines. Docker configures these paths automatically.
PDF_ENGINES_PYTHON=
PDFBOX_JAR=
PDFBOX_JAVA=java
PDF_TEXT_ENGINE=auto
PDF_RASTERIZER=auto
PDF_OCR_BACKEND=auto
