# Runtime
PORT=3000
NEXT_PUBLIC_SITE_URL=https://www.pdfmasterpro.com.br

# Optional server-side processing binaries
PDF_RENDERER=pdftoppm
PDF_COMPRESSOR=gs
PDF_TEXT_EXTRACTOR=pdftotext
PDF_HTML_CONVERTER=pdftohtml
OCR_ENGINE=tesseract
PDF_PROTECTOR=qpdf
# Motores Word: msword usa o Microsoft Word instalado (recomendado); valores alternativos
# mantêm a reserva (PDF_TO_WORD_CONVERTER=rebuild recria o layout; SOFFICE_CONVERTER usa o LibreOffice).
PDF_TO_WORD_CONVERTER=msword
WORD_CONVERTER=msword
SOFFICE_CONVERTER=soffice
# Opcional: pasta com os traineddata do Tesseract (útil quando o install é por usuário)
TESSDATA_PREFIX=

# Managed database is injected by WebDev when enabled
DATABASE_URL=

# Manus OAuth is injected by WebDev in Cloud/Preview
MANUS_PROJECT_ID=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=
MANUS_JWT_SECRET=

# Google Identity Services OAuth Client ID (public value).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Used for app sessions when Manus OAuth is not configured.
AUTH_SESSION_SECRET=

# Google AdSense: public publisher client ID, format ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
